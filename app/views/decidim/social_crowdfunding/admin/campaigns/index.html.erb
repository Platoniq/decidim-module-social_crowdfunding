<%= append_stylesheet_pack_tag "decidim_social_crowdfunding" %>
<%= append_javascript_pack_tag "decidim_social_crowdfunding" %>
<div class="card admin social-crowdfunding-campaign">
  <div class="item_show__header">
    <h2 class="item_show__header-title">
      <%= t(".title") %>
      <div class="flex align-left gap-x-4">
        <%= link_to create_campaign_path, class: "button button__sm button__secondary button--simple button--goteo", target: :blank do %>
          <%= t(".create") %>
          <%= render partial: "decidim/social_crowdfunding/goteo_logo" %>
          <%= icon "external-link-line" %>
        <% end %>
        <%= link_to manage_campaign_path, class: "button button__sm button__secondary button--simple" do %>
          <%= icon "settings-4-line" %>
          <%= t(".manage") %>
        <% end %>
        <%= link_to goteo_configurations_path, class: "button button__sm button__secondary" do %>
          <%= icon "account-circle-line" %>
          <%= t(".manage_configurations") %>
        <% end %>
      </div>
    </h2>
  </div>
  <% if current_goteo_config_valid? && current_campaign %>
    <div class="card-section">
      <h3>
        <b><%= t(".selected") %>:</b> <span><%= translated_attribute(current_campaign.name) %></span>
      </h3>
      <%= link_to main_component_path(current_component), class: "button button__sm button__secondary button--simple campaign__see-component", target: "_blank", data: { "external-link": false } do %>
        <%= icon "eye-line" %>
        <span><%= t(".see_component") %></span>
      <% end %>
    </div>
  <% end %>
  <div class="card-section">
    <h3>
      <b><%= t(".fetch") %></b>
    </h3>
    <%= decidim_form_for @form, url: fetch_campaigns_path do |f| %>
      <%= f.text_field :slug, label: t(".slug"), class: "slug-input" %>
      <div class="help-text mb-s">
        <%= t(".slug_info") %>
      </div>
      <%= f.submit t(".fetch_submit"), class: "button button__sm button__secondary button--simple", id: "fetch-campaign-btn" %>
    <% end %>
  </div>
  <h2 class="card-title">
    <%= t(".campaigns") %>
  </h2>
  </div>
  <div class="table-scroll">
    <table class="table-list">
      <thead>
        <tr>
          <th><%= t("models.campaign.fields.slug", scope: "decidim.social_crowdfunding") %></th>
          <th><%= t("models.campaign.fields.title", scope: "decidim.social_crowdfunding") %></th>
          <th><%= t("models.campaign.fields.created_at", scope: "decidim.social_crowdfunding") %></th>
          <th class="actions"><%= t("actions.title", scope: "decidim.social_crowdfunding") %></th>
        </tr>
      </thead>
      <tbody>
        <% campaigns.each do |campaign| %>
          <% selected = current_campaign&.slug == campaign.slug %>
          <tr data-id="<%= campaign.id %>" style="<%= "background-color: rgba(0, 150, 80, 0.08);" if selected %>">
            <td>
              <%= campaign.slug %>
              <% if selected %>
                <span class="badge badge--success"><%= t(".active") %></span>
              <% end %>
            </td>
            <td>
              <%= translated_attribute(campaign.name) %><br>
            </td>
            <td>
              <%= l campaign.created_at, format: "%d/%m/%Y - %H:%M" %>
            </td>
            <td class="table-list__actions">
              <% if allowed_to?(:update, :campaign, campaign: campaign) && !selected %>
                <%= icon_link_to "check-line", select_campaigns_path(slug: campaign.slug), t("actions.select", scope: "decidim.social_crowdfunding"), method: :post, class: "action-icon--select action-icon--select-campaign" %>
              <% end %>
              <% if allowed_to? :update, :campaign, campaign: campaign %>
                <%= icon_link_to "refresh-line", campaign_path(campaign), t("actions.update", scope: "decidim.social_crowdfunding"), method: :put, class: "action-icon--reload action-icon--reload-campaign" %>
              <% end %>
              <% if allowed_to? :destroy, :campaign, campaign: campaign %>
                <%= icon_link_to "close-circle-line", campaign_path(campaign), t("actions.destroy", scope: "decidim.social_crowdfunding"), method: :delete, class: "action-icon--remove", data: { confirm: t("actions.confirm_campaign_destroy", scope: "decidim.social_crowdfunding") } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= paginate campaigns, theme: "decidim" %>
  </div>
</div>
