<%= append_stylesheet_pack_tag "decidim_social_crowdfunding" %>
<div class="card admin social-crowdfunding-campaign">
  <div class="item_show__header">
    <h2 class="item_show__header-title">
      <%= t(".title") %>
      <div class="flex align-left gap-x-4">

          <%= link_to campaigns_path, class: "button button__sm button__secondary" do %>
            <%= icon "account-circle-line" %>
            <%= t(".campaigns") %>
          <% end %>

          <%= link_to new_goteo_configuration_path, class: "button button__sm button__secondary" do %>
            <%= icon "account-circle-line" %>
            <%= t(".create_configuration") %>
          <% end %>

      </div>
    </h2>
  </div>

  <h2 class="card-title">
    <%= t(".title") %>
  </h2>
  </div>
  <div class="table-scroll">
    <table class="table-list">
      <thead>
        <tr>
          <th><%= t("models.goteo_configuration.fields.id", scope: "decidim.social_crowdfunding") %></th>
          <th><%= t("models.goteo_configuration.fields.email", scope: "decidim.social_crowdfunding") %></th>
          <th><%= t("models.goteo_configuration.fields.updated_at", scope: "decidim.social_crowdfunding") %></th>
          <th class="actions"><%= t("actions.title", scope: "decidim.social_crowdfunding") %></th>
        </tr>
      </thead>
      <tbody>
        <% goteo_configurations.each do |goteo_configuration| %>
          <tr data-id="<%= goteo_configuration.id %>">
            <td>
              <%= goteo_configuration.id %><br>
            </td>
            <td>
              <%= goteo_configuration.email %><br>
            </td>
            <td>
              <%= l goteo_configuration.updated_at, format: "%d/%m/%Y - %H:%M" %>
            </td>
            <td class="table-list__actions">
              <% if allowed_to? :destroy, :goteo_configuration, goteo_configuration: goteo_configuration %>
                <%= icon_link_to "close-circle-line", goteo_configuration_path(goteo_configuration), t("actions.destroy", scope: "decidim.social_crowdfunding"), method: :delete, class: "action-icon--remove", data: { confirm: t("actions.confirm_config_destroy", scope: "decidim.social_crowdfunding") } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= paginate goteo_configurations, theme: "decidim" %>
  </div>
</div>
