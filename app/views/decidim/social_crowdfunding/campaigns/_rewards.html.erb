<h3 class="h3 decorator">
  <%= t(".title") %>
</h3>

<div class="card__list-list aside__list">
  <% rewards = current_campaign.rewards %>

  <% (rewards[I18n.locale.to_s] || rewards.values.first).slice!(0, 3).each do |reward| %>
    <%= render partial: "decidim/social_crowdfunding/campaigns/reward", locals: { reward: reward } %>
  <% end %>
</div>

<div class="more__rewards">
  <a id="more-rewards-button" href="#" class="button button__sm md:button__lg toggle-arrow" data-target="more-rewards">
    <%= t(".see_all") %>
    <%= icon "arrow-right-s-line", class: "toggle-arrow__icon" %>
  </a>
</div>

<div id="more-rewards" class="collapsible-list row small-up-1 card-grid toggle-hidden">
  <% (rewards[I18n.locale.to_s] || rewards.values.first).each do |reward| %>
    <%= render partial: "decidim/social_crowdfunding/campaigns/reward", locals: { reward: reward } %>
  <% end %>
</div>
