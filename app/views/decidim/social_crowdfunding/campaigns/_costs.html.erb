<table class="table__costs">
  <% campaign_grouped_costs.each do |type, costs| %>
    <thead>
      <tr>
        <td>
          <b><%= t(".#{type}") %></b>
        </td>
        <td style="width: 15%;">
          <b><%= t(".category") %></b>
        </td>
        <td style="width: 15%;">
          <b><%= t(".amount") %></b>
        </td>
      </tr>
    </thead>

    <tbody>
      <% costs.sort_by { |c| c["deadline"] }.each do |cost| %>
        <tr>
          <td>
            <strong>
              <%= translated_attribute cost["title"] %>
            </strong>
            <br>
            <%= render_markdown translated_attribute cost["description"] %>
          </td>

          <td>
              <%= cost["deadline"] %>
          </td>

          <td>
              <%= campaign_money(translated_attribute cost["money"]["amount"]) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  <% end %>

  <tfoot>
    <tr>
      <td>
        <b><%= t(".total") %></b>
      </td>
      <td>
      </td>
      <td>
        <b><%= campaign_money(campaign_total_minimum) %></b>
      </td>
    </tr>
  </tfoot>
</table>
